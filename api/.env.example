PORT=4000

# Base de datos (Turso). DATABASE_URL solo la usa la CLI de Prisma (prisma generate).
TURSO_DATABASE_URL=libsql://tu-base-tu-usuario.turso.io
TURSO_AUTH_TOKEN=
DATABASE_URL=file:./dev.db

# Sesión de la app: una cadena larga y secreta (32 caracteres o más).
JWT_SECRET=

# Desde dónde puede llamar a la API la versión web de la app.
CORS_ORIGIN=http://localhost:8081

# Inicio de sesión con Google (ver api/README.md para crear estas credenciales).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTO con un "URI de redireccionamiento autorizado" del cliente de Google.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Opcional: destinos extra a los que se puede devolver a la persona al terminar,
# separados por coma: "esquema://" o un origen https (ej. https://app.conecta.cr).
# Siempre se permite conectaplus://. En desarrollo también Expo Go (exp://) y localhost.
APP_REDIRECT_ALLOWLIST=
